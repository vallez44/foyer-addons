# foyer.env: write it yourself on the Home Assistant computer (nano foyer.env), then: chmod 600 foyer.env
# Home Assistant's address, as seen from this computer.
HA_URL=http://localhost:8123
# A long-lived access token: Home Assistant -> your profile -> Security -> Long-lived access tokens -> Create token.
# Keep it in this file only.
HA_TOKEN=paste-the-token-here
# Optional: a fixed pairing code of 8 to 12 digits (changing it forgets every paired screen).
# FOYER_PAIRING_CODE=
# Optional: other names your iPads use to open Foyer, comma separated.
# FOYER_ALLOWED_HOSTS=foyer.maison.lan
